library (cpu_top) {
  comment                        : "";
  delay_model                    : table_lookup;
  simulation                     : false;
  capacitive_load_unit (1,pF);
  leakage_power_unit             : 1pW;
  current_unit                   : "1A";
  pulling_resistance_unit        : "1kohm";
  time_unit                      : "1ns";
  voltage_unit                   : "1v";
  library_features(report_delay_calculation);

  input_threshold_pct_rise : 50;
  input_threshold_pct_fall : 50;
  output_threshold_pct_rise : 50;
  output_threshold_pct_fall : 50;
  slew_lower_threshold_pct_rise : 20;
  slew_lower_threshold_pct_fall : 20;
  slew_upper_threshold_pct_rise : 80;
  slew_upper_threshold_pct_fall : 80;
  slew_derate_from_library : 1.0;


  nom_process                    : 1.0;
  nom_temperature                : 100.0;
  nom_voltage                    : 1.60;

  type ("seg1") {
    base_type : array;
    data_type : bit;
    bit_width : 7;
    bit_from : 6;
    bit_to : 0;
  }
  type ("seg2") {
    base_type : array;
    data_type : bit;
    bit_width : 7;
    bit_from : 6;
    bit_to : 0;
  }

  cell ("cpu_top") {
    interface_timing : true;
    pin("clk") {
      direction : input;
      clock : true;
      capacitance : 0.0000;
      timing() {
        timing_sense : positive_unate;
        timing_type : min_clock_tree_path;
	cell_rise(scalar) {
          values("INF");
	}
	cell_fall(scalar) {
          values("INF");
	}
      }
      timing() {
        timing_sense : positive_unate;
        timing_type : max_clock_tree_path;
	cell_rise(scalar) {
          values("-INF");
	}
	cell_fall(scalar) {
          values("-INF");
	}
      }
    }
    pin("control_btn") {
      direction : input;
      capacitance : 0.0000;
    }
    pin("reset") {
      direction : input;
      capacitance : 0.0000;
    }
    bus("seg1") {
      bus_type : seg1;
      direction : output;
      capacitance : 0.0000;
    pin("seg1[6]") {
      direction : output;
      capacitance : 0.0005;
    }
    pin("seg1[5]") {
      direction : output;
      capacitance : 0.0006;
    }
    pin("seg1[4]") {
      direction : output;
      capacitance : 0.0005;
    }
    pin("seg1[3]") {
      direction : output;
      capacitance : 0.0005;
    }
    pin("seg1[2]") {
      direction : output;
      capacitance : 0.0006;
    }
    pin("seg1[1]") {
      direction : output;
      capacitance : 0.0006;
    }
    pin("seg1[0]") {
      direction : output;
      capacitance : 0.0005;
    }
    }
    bus("seg2") {
      bus_type : seg2;
      direction : output;
      capacitance : 0.0000;
    pin("seg2[6]") {
      direction : output;
      capacitance : 0.0005;
    }
    pin("seg2[5]") {
      direction : output;
      capacitance : 0.0006;
    }
    pin("seg2[4]") {
      direction : output;
      capacitance : 0.0006;
    }
    pin("seg2[3]") {
      direction : output;
      capacitance : 0.0005;
    }
    pin("seg2[2]") {
      direction : output;
      capacitance : 0.0007;
    }
    pin("seg2[1]") {
      direction : output;
      capacitance : 0.0005;
    }
    pin("seg2[0]") {
      direction : output;
      capacitance : 0.0005;
    }
    }
  }

}
